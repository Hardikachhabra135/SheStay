# SheStay Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=

# Model Name (e.g. gemini-1.5-flash or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origin (* for development or https://your-frontend.vercel.app for production)
CORS_ORIGIN=*

